@* Feature: AppLogging — "the user can see and filter what the application is doing".
   Shown in MainLayout, so the log is reachable from every screen. *@

@using Fluxor
@using Fluxor.Blazor.Web.Components

@using Zat.Tests.Runner.Common.Net.Application.Logging
@using Zat.Tests.Runner.WebApp.Shared.Model
@using Zat.Tests.Runner.WebApp.Shared.Stores.AppLogging

@inherits FluxorComponent;

<section class="app-log-panel @(this.isCollapsed ? "is-collapsed" : "is-expanded")">
    <header class="app-log-header">
        <button type="button"
                class="btn btn-sm btn-outline-secondary toggle-button"
                title="@(this.isCollapsed ? "Expand the log" : "Collapse the log")"
                @onclick="this.ToggleCollapsedAsync">
            @(this.isCollapsed ? "▲" : "▼")
        </button>

        <span class="pane-title">Log</span>

        @if (this.isCollapsed)
        {
            @* Collapsed means "no log content" — only the error count stays as a summary indicator. *@
            <span class="error-count @(this.ErrorCount > 0 ? "has-errors" : null)">
                @this.ErrorCount error(s)
            </span>
        }
        else
        {
            <div class="filters">
                <span class="filter-group">
                    @foreach (var severity in Enum.GetValues<LogLevel>())
                    {
                        <label class="form-check-label filter-option">
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@this.filter.IsSelected(severity)"
                                   @onchange="args => this.filter.SetSelected(severity, (bool)args.Value!)" />
                            @severity
                        </label>
                    }
                </span>

                <span class="filter-group">
                    @foreach (var source in this.AvailableSources)
                    {
                        <label class="form-check-label filter-option">
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@this.filter.IsSelected(source)"
                                   @onchange="args => this.filter.SetSelected(source, (bool)args.Value!)" />
                            @source
                        </label>
                    }
                </span>
            </div>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary jump-button"
                    @onclick="this.ScrollToNewestAsync">
                Jump to newest
            </button>
        }
    </header>

    @if (!this.isCollapsed)
    {
        <div class="app-log-entries" @ref="this.entriesElement">
            @foreach (var entry in this.filter.Apply(this.Entries))
            {
                <div class="log-entry severity-@entry.LogLevel.ToString().ToLowerInvariant()">
                    <span class="entry-time">@entry.Timestamp.ToString("HH:mm:ss.fff")</span>
                    <span class="entry-severity">@entry.LogLevel</span>
                    <span class="entry-source">@entry.Source</span>
                    <span class="entry-message">@entry.Message</span>
                </div>

                if (!string.IsNullOrEmpty(entry.Detail))
                {
                    <pre class="entry-detail">@entry.Detail</pre>
                }
            }
        </div>
    }
</section>

@code {
    private const string ModulePath = "./Features/AppLogging/Components/AppLoggerView.razor.js";
    private const byte MaxRefreshesPerSecond = 6;

    private readonly AppLoggerFilter filter = AppLoggerFilter.CreateDefault();
    private ElementReference entriesElement;
    private JsModuleInterop? jsModuleInterop;

    private bool isCollapsed;

    /// <summary>
    /// Raised after the panel collapse state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> CollapsedChanged { get; set; }

    [Inject]
    private IDispatcher Dispatcher { get; set; } = null!;

    [Inject]
    private IState<AppLoggingState> AppLoggingState { get; set; } = null!;

    /// <summary>
    /// Gets or sets the factory the JS module interop is created through.
    /// </summary>
    [Inject]
    private IJsModuleInteropFactory JsModuleInteropFactory { get; set; } = null!;

    private IReadOnlyList<LogEntry> Entries 
        => this.AppLoggingState.Value.Entries;

    private int ErrorCount 
        => this.Entries.Count(entry => entry.LogLevel == LogLevel.Error);

    private JsModuleInterop JsModuleInterop 
        => this.jsModuleInterop ??= this.JsModuleInteropFactory.Create(ModulePath);

    private IEnumerable<string> AvailableSources 
        => LogSources.All
            .Concat(this.Entries.Select(entry => entry.Source))
            .Distinct(StringComparer.OrdinalIgnoreCase);

    /// <inheritdoc/>
    protected override async ValueTask DisposeAsyncCore(bool disposing)
    {
        // The module is only imported when the user jumps to the newest entry, so a panel nobody
        // scrolled has nothing to release.
        if (this.jsModuleInterop is not null)
        {
            await this.jsModuleInterop.DisposeAsync();
        }

        await base.DisposeAsyncCore(disposing);
    }

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.MaximumStateChangedNotificationsPerSecond = MaxRefreshesPerSecond;
    }

    private async Task ToggleCollapsedAsync()
    {
        this.isCollapsed = !this.isCollapsed;
        await this.CollapsedChanged.InvokeAsync(this.isCollapsed);
    }

    private Task ScrollToNewestAsync()
        => this.JsModuleInterop.InvokeVoidSafeAsync("scrollToEnd", this.entriesElement);
}

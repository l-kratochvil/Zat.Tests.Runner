@* Edits an email recipient list: removes recipients and adds new ones through a confirmed form. *@

@using Zat.Tests.Runner.WebApp.Shared.Validation

@inherits Zat.Tests.Runner.WebApp.Components.MvvmComponentBase<EmailAddressesEditorViewModel>

<DataContext Data="this.ViewModel">
    <Validated Validity="this.Validity">
        <ItemList TItem="string"
                  TCollection="List<string>"
                  Items="this.items"
                  CreateItem="this.ViewModel.BeginAdd"
                  OnAdd="this.PublishAsync"
                  OnRemove="this.PublishAsync"
                  IsAddEnabled="!this.ViewModel.IsEditing"
                  IsRemoveEnabled="!this.ViewModel.IsEditing" />
    </Validated>

    @if (this.ViewModel.IsEditing)
    {
        <span class="d-flex align-items-start gap-1">
            <span class="flex-grow-1">
                <BindingInput Class="input-email-address" 
                                Binding="@(vm => vm.EmailAddress)"
                                BindingEvent="BindingEvent.OnInput"
                                aria-label="New email address"
                                Placeholder="name@zat.cz" />
            </span>

            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    disabled="@(!this.ViewModel.CanConfirm)"
                    @onclick="this.ViewModel.Confirm">OK</button>

            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    @onclick="this.ViewModel.Cancel">Cancel</button>
        </span>

    }
</DataContext>

@code {
    // The working copy the list edits in place; every edit is handed back as a new list.
    private List<string> items = [];

    /// <summary>
    /// Gets or sets the recipients edited.
    /// </summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<string> EmailAddresses { get; set; }

    /// <summary>
    /// Gets or sets what is told the recipients once one has been added or removed.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyList<string>> EmailAddressesChanged { get; set; }

    /// <summary>
    /// Gets or sets what is wrong with the recipients.
    /// </summary>
    [Parameter]
    public Validity Validity { get; set; } = Validity.Valid;

    protected override EmailAddressesEditorViewModel ViewModel { get; set; } = null!;

    protected override void OnInitialized()
    {
        this.ViewModel = new EmailAddressesEditorViewModel(() => this.items);

        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        this.items = [.. this.EmailAddresses];

        base.OnParametersSet();
    }

    private Task PublishAsync(string _)
        => this.EmailAddressesChanged.InvokeAsync([.. this.items]);

    /// <inheritdoc/>
    public override ValueTask DisposeAsync()
    {
        // Lets the list waiting for an address being added go on when the editor disappears mid-way.
        this.ViewModel.Cancel();
        return base.DisposeAsync();
    }
}

@* Feature: TestConfiguration — "the user can configure a test run". *@

@using System.Linq

@using Zat.Z2xxTests.Common.Model

@inherits Zat.Tests.Runner.WebApp.Components.MvvmComponentBase<TestConfigurationViewModel>

<section class="test-configurator">
    <h2 class="pane-title">Configuration</h2>

    <DataContext Data="@this.ViewModel">
        <PropertyGrid>
            <PropertyGridRow Label="Runtime version">
                <BindingSelect
                    Class="input-runtime-version"
                    Binding="@(vm => vm.RuntimeVersion)"
                    Options="this.ViewModel.RuntimeVersions"
                    Placeholder="—" />
            </PropertyGridRow>

            @if (this.ViewModel.IsRuntimeTest)
            {
                <PropertyGridRow Label="HW assembly type">
                    <BindingSelect
                        Class="input-hw-assembly-type"
                        Binding="@(vm => vm.TestedHwAssembly)"
                        Options="TestStationLabels.Offered.Cast<HwAssemblyType?>()"
                        Placeholder="—" />
                </PropertyGridRow>
            }

            <PropertyGridRow Label="Report to TestLink">
                <BindingCheckbox 
                    Class="input-report-to-testlink"
                    Binding="@(vm => vm.IsTestLinkReportEnabled)" />
            </PropertyGridRow>

            @if (this.ViewModel.IsTestLinkReportEnabled)
            {               
                <PropertyGridRow Label="IDE version">
                    <BindingInput 
                        Class="input-ide-version"
                        Binding="@(vm => vm.IdeVersion)"
                        Placeholder="X.Y.Z" />               
                </PropertyGridRow>
            }
        </PropertyGrid>
    </DataContext>
</section>

@code {
    [Inject]
    protected override TestConfigurationViewModel ViewModel { get; set; } = null!;

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.ViewModel.Initialize();
    }
}
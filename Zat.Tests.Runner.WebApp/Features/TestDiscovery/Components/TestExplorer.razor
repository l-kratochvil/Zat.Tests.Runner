@* Feature: TestDiscovery — "the user can browse and select tests to run". *@

@inherits Zat.Tests.Runner.WebApp.Components.MvvmComponentBase<TestExplorerViewModel>

<section class="test-explorer">
    <div class="pane-header">
        <h2 class="pane-title">Test Explorer</h2>
        @this.HeaderActions
    </div>

    @if (this.ViewModel.IsEmpty)
    {
        <p class="placeholder-note">No tests loaded</p>
    }
    else
    {
        <ul class="test-tree">
            @foreach (var root in this.ViewModel.Roots)
            {
                <TestTreeNode Data="root" @key="root.ExecutionPath" SelectionChanged="this.ViewModel.OnSelectionChanged" />
            }
        </ul>
    }
</section>

@code {
    [Inject]
    protected override TestExplorerViewModel ViewModel { get; set; } = null!;

    /// <summary>
    /// Gets or sets what is drawn in the header row beside the title, such as the button that
    /// starts a test run. Nothing when the explorer is used on its own.
    /// </summary>
    [Parameter]
    public RenderFragment? HeaderActions { get; set; }
}

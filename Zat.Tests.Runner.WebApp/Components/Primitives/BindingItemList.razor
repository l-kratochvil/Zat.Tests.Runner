@* A list read from the cascaded view model, with a remove action for each item and an optional add flow. *@

@using System.ComponentModel
@using System.Linq.Expressions
@using Zat.Tests.Runner.WebApp.Shared.Validation
@using Zat.Tests.Runner.WebApp.Shared.ViewModel

@typeparam TDataContext where TDataContext : class, INotifyPropertyChanged, INotifyDataInfo

@inherits MvvmComponentBase<TDataContext>

<Validated Validity="this.Validity">
    <span class="d-flex flex-column gap-1">
        @foreach (var item in this.Items)
        {
            <span class="d-flex align-items-center gap-2">
                <span class="text-break">@item</span>
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        aria-label="@($"Remove {item}")"
                        @onclick="() => this.OnRemove.InvokeAsync(item)">Remove</button>
            </span>
        }

        @if (this.IsAdding)
        {
            @this.ChildContent
        }

        @if (this.OnAdd.HasDelegate)
        {
            <span>
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        disabled="@this.IsAdding"
                        @onclick="() => this.OnAdd.InvokeAsync()">Add</button>
            </span>
        }
    </span>
</Validated>

@code {
    private Func<TDataContext, IReadOnlyList<string>>? readItems;

    private string bindedPropertyName = string.Empty;

    [Parameter, EditorRequired]
    public required Expression<Func<TDataContext, IReadOnlyList<string>>> Binding { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnRemove { get; set; }

    /// <summary>
    /// Gets or sets what starts adding an item; the Add button is shown only when set.
    /// </summary>
    [Parameter]
    public EventCallback OnAdd { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether an item is being added, which disables Add and shows <see cref="ChildContent"/>.
    /// </summary>
    [Parameter]
    public bool IsAdding { get; set; }

    /// <summary>
    /// Gets or sets the form an item is added through.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private IReadOnlyList<string> Items
        => this.readItems?.Invoke(this.ViewModel) ?? [];

    private Validity Validity
        => this.ViewModel is INotifyValidityInfo source
            ? source.GetValidity(this.bindedPropertyName) ?? Validity.Valid
            : Validity.Valid;

    protected override void OnInitialized()
    {
        this.readItems = this.Binding.Compile();
        this.bindedPropertyName = this.Binding.Body is MemberExpression member
            ? member.Member.Name
            : throw new InvalidOperationException(
                $"The binding of a {this.GetType().Name} must name a property of {typeof(TDataContext).Name} directly.");
        base.OnInitialized();
    }
}

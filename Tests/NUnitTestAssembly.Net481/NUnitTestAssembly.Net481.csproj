<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net481</TargetFramework>
		<!-- StreamJsonRpc needs binding redirects, which the proxy applies from the configuration file. -->
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NUnit" Version="3.14.0" PrivateAssets="all" />
		<PackageReference Include="StreamJsonRpc" Version="2.25.29" />
		<ProjectReference Include="..\NUnitTestAssembly.Common\NUnitTestAssembly.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Zat.Z2xxTests.Common\Zat.Z2xxTests.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.Configuration" />
	</ItemGroup>

	<!--
		Stage the built test assembly (and its dependencies) so the proxy tests
		can load it. Mirrors the CopyExchangeFiles target in the proxy project.
	-->
	<Target Name="CopyToNUnitTestAssembliesExchange" AfterTargets="Build">
		<PropertyGroup>
			<DestinationDir>$(NUnitTestAssembliesDir)$(AssemblyName)\</DestinationDir>
		</PropertyGroup>

		<ItemGroup>
			<OutFile Include="$(TargetDir)\**\*" />
		</ItemGroup>
		<RemoveDir Directories="$(DestinationDir)" />
		<Copy SourceFiles="@(OutFile)" DestinationFiles="$(DestinationDir)%(OutFile.RecursiveDir)%(OutFile.Filename)%(OutFile.Extension)" />
	</Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net481</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NUnit" Version="3.14.0" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.Configuration" />
	</ItemGroup>

	<!--
		Stage the built test assembly (and its dependencies) so the proxy tests
		can load it. Mirrors the CopyExchangeFiles target in the proxy project.
	-->
	<Target Name="CopyToNUnitTestAssembliesExchange" AfterTargets="Build">
		<PropertyGroup>
			<DestinationDir>$(NUnitTestAssembliesDir)$(AssemblyName)\</DestinationDir>
		</PropertyGroup>

		<ItemGroup>
			<OutFile Include="$(TargetDir)\**\*" />
		</ItemGroup>
		<RemoveDir Directories="$(DestinationDir)" />
		<Copy SourceFiles="@(OutFile)" DestinationFiles="$(DestinationDir)%(OutFile.RecursiveDir)%(OutFile.Filename)%(OutFile.Extension)" />
	</Target>

</Project>

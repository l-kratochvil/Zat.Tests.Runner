{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      // Assembly name must be the same as the root dir name
      "program": "${workspaceFolder}/bin/Debug/net10.0/${workspaceFolderBasename}.dll",
      "args": [],
      "cwd": "${workspaceFolder}/bin/Debug/net10.0",
      // Spectre.Console needs a real console handle; the Debug Console (internalConsole) has none.
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
